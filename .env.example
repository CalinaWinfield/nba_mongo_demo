# MongoDB Connection String
# Option 1: MongoDB Atlas cluster (replace with your active cluster connection string)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-domain>.mongodb.net/?appName=nbaStats

# Option 2: Local MongoDB instance
# MONGODB_URI=mongodb://127.0.0.1:27017/nba_stats

# Backend Server Port (defaults to 5000 if not set)
PORT=5000

# Note: If MONGODB_URI is unreachable or not configured, the server automatically
# starts in demo fallback mode using 10 realistic NBA game logs so that the app
# runs properly without any manual database setup required.
