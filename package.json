{
  "name": "nba-mongo-demo",
  "version": "1.0.0",
  "description": "NBA stats demo application with Express backend, MongoDB Atlas / in-memory fallback, and React frontend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm start --prefix nba-frontend",
    "dev": "concurrently -n \"API,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "seed": "node mongodbExample.js",
    "test": "npm test --prefix nba-frontend -- --watchAll=false",
    "build": "npm run build --prefix nba-frontend"
  },
  "keywords": [
    "nba",
    "mongodb",
    "express",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "mongodb": "^7.1.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
